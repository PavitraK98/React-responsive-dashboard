<div class="row">
    <div class="col-sm-12 mb-3">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" value="notification" />
            <label class="form-check-label ml-2" for="radioDefault1">
                <p>Yes, I expressly consent to receive emails from Tarte!
                    You can unsubscribe any time by emailing info@tarte.com or clicking the link at the bottom of our
                    emails. <a href="#" class="text-decoration-underline">Privacy Policy</a> and <a href="#"
                        class="text-decoration-underline">Terms & Conditions</a></p>
            </label>
        </div>
    </div>
</div>

<div class="row d-flex justify-content-center align-items-end mb-2">
    <div class="col-sm-6">
        <div class="form-group">
            <div class="form-text">Ensure name entered matches ID</div>
            <input autofocus type="text" class="form-control" placeholder="* First Name" />
        </div>
    </div>
    <div class="col-sm-6">
        <div class="form-group">
            <input type="text" class="form-control" placeholder="* Last Name" />
        </div>
    </div>
</div>

<div class="row mt-2 mb-2">
    <div class="col-sm-12">
        <div class="form-group">
            <input type="text" class="form-control" placeholder="* Address Line 1" />
        </div>
    </div>
</div>


<div class="row mt-2 mb-2">
    <div class="col-sm-12">
        <div class="form-group">
            <input type="text" class="form-control" placeholder="* Address Line 2" />
        </div>
    </div>
</div>

<!--- make drop down--->
<div class="row mt-2 mb-2">
    <div class="col-sm-6">
        <isinclude template="trateCheckout/deliveryAddressSection/countrySelector" />
    </div>
    <div class="col-sm-6">
        <isinclude template="trateCheckout/deliveryAddressSection/stateSelector" />
    </div>
</div>

<div class="row mt-2 mb-2">
    <div class="col-sm-6">
        <div class="form-group">
            <input type="text" class="form-control" placeholder="* City" autocomplete="shipping address-level2" />
        </div>
    </div>
    <div class="col-sm-6">
        <div class="form-group">
            <input type="text" class="form-control" placeholder="* Postal Code" autocomplete="shipping postal-code" />
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-sm-6">
        <div class="region-section">
            <p>* Country/Region <br /> <span class="ml-3">United States</span></p>
            <img src='${URLUtils.staticURL("/images/info.png")}' alt="original" width="20" height="20" />
        </div>
    </div>
</div>

<div class="row mb-2">
    <div class="col-sm-6">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" value="saveAddress" />
            <label class="form-check-label" for="saveAddress">
                <p class="lh-sm ml-2">Save this address for my next purchase.</p>
            </label>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-sm-6">
        <div class="form-group">
            <div class="input-group">
                <select class="form-select w-auto p-1 border border-none" name="phoneCountryCode">
                    <option value="+91" data-flag="in">🇮🇳 &nbsp;+91</option>
                    <option value="+1" data-flag="us">🇺🇸 &nbsp;+1</option>
                    <option value="+1" data-flag="ca">🇨🇦 &nbsp;+1</option>
                    <option value="+44" data-flag="gb">🇬🇧 &nbsp;+44</option>
                    <option value="+61" data-flag="au">🇦🇺 &nbsp;+61</option>
                    <option value="+49" data-flag="de">🇩🇪 &nbsp;+49</option>
                    <option value="+33" data-flag="fr">🇫🇷 &nbsp;+33</option>
                    <option value="+81" data-flag="jp">🇯🇵 &nbsp;+81</option>
                </select>
                <input type="tel" class="form-control" placeholder="8754876534" autocomplete="shipping tel" />
            </div>
            <div class="form-text">We need your phone number to assist delivery.</div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <p>Please note, by continuing with checkout ESW will process your personal data in accordance with its Data
            Privacy Statement. You can read about how and why ESW processes personal data here.</p>
        <p>Please review your shipping information, as once an order is placed it cannot be cancelled or modified.</p>
    </div>
</div>


<div class="row">
    <div class="col-sm-6">
        <button type="button" class="btn btn-dark p-2 rounded-0 d-flex justify-content-center align-items-center">
            NEXT: PAYMENT <span class="m-2"><img src='${URLUtils.staticURL("/images/lock-white.png")}' alt="original"
                    width="15" height="15" /></span>
        </button>
    </div>
</div>