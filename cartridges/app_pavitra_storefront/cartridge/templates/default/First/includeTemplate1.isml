<div class="card">
    <isif condition="${pdict.productDetails.length > 0}">
        <table class="table table-bordered">
            <isloop items="${pdict.productDetails}" var="product" status="loopstatus">
                <tr>
                    <td>
                        <isprint value="${product.getID()}" encoding="on" />
                    </td>
                    <td>
                        <isprint value="${product.getName()}" encoding="on" />
                    </td>
                    <td>
                        <isprint value="${product.getBrand()}" encoding="on" />
                    </td>
                </tr>
            </isloop>
        </table>
    </isif>
</div>