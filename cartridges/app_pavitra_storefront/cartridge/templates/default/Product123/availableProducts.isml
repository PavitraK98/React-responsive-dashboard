<isdecorate template="common/layout/page">
    <div class="card">
        <div class="card-body">
            <isif condition="${pdict.productDetails.length > 0}">
                <div class="card">
                    <div class="card-body">
                        <isif condition="${pdict.productDetails.length > 0}">
                            <table class="table table-bordered">
                                <tr>
                                    <th>${Resource.msg('Lable.item.id', 'product', null)}</th>
                                    <th>${Resource.msg('Label.item.name', 'product', null)}</th>
                                    <th>${Resource.msg('Label.item.manufacture', 'product', null)}</th>
                                    <th>${Resource.msg('Label.price', 'product', null)}</th>
                                    <th>${Resource.msg('Label.item.online', 'product', null)}</th>
                                    <th>${Resource.msg('Lable.item.search', 'product', null)}</th>
                                </tr>
                                <isloop items="${pdict.productDetails}" var="product" status="loopstatus">
                                    <tr>
                                        <td>
                                            <isprint value="${product.id}" encoding="on" />
                                        </td>
                                        <td>
                                            <isprint value="${product.name}" encoding="on" />
                                        </td>
                                        <td>
                                            <isprint value="${product.manufacturer}" encoding="on" />
                                        </td>
                                        <td>
                                            <isprint value="${product.price}" encoding="on" />
                                        </td>
                                        <td>
                                            <isprint value="${product.online}" encoding="on" />
                                        </td>
                                        <td>
                                            <isprint value="${product.searchable}" encoding="on" />
                                        </td>
                                    </tr>
                                </isloop>
                            </table>
                        </isif>
                    </div>
                </div>
            </isif>
        </div>
    </div>
</isdecorate>
