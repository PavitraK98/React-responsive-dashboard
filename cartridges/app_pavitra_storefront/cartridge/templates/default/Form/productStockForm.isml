<isdecorate template="common/layout/page">
    <div class="container mt-4 mb-4">
        <div class="card p-4">
            <h3 class="card-title d-flex justify-content-center">
                ${Resource.msg('text.heading.fill.details', 'userlabels', null)}
            </h3>
            <form class="row g-3" action="${pdict.submitURL}" method="post">

                <div class="col-6 mt-3">
                    <label class="form-label" for="productID">
                        ${Resource.msg("Lable.item.id", 'product', null)}
                    </label>
                    <input type="text" class="form-control" name="productID" required />
                </div>

                <div class="col-6 mt-3">
                    <label class="form-label" for="quantity">
                        ${Resource.msg('Label.item.quantity', 'product', null)}
                    </label>
                    <input type="text" class="form-control" name="quantity" required />
                </div>


                <div class="col-12 mt-4">
                    <button type="submit" class="btn btn-primary">
                        ${Resource.msg('user.label.submit', 'userlabels', null)}
                    </button>
                </div>
            </form>
        </div>
    </div>
</isdecorate>