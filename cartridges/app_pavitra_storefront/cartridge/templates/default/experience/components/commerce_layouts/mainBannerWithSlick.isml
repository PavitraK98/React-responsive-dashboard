<isscript>
        var assets = require('*/cartridge/scripts/assets');
        assets.addCss('/css/customLayout.css');
</isscript>
<div class="skinn-main-banner-container">
    <div class="main-banner-imgs-container">
        <picture>
            <source media="(max-width: 480px)" srcset="${pdict.image1.src.mobile}" />
            <source media="(max-width: 768px)" srcset="${pdict.image1.src.tablet}" />
            <img src="${pdict.image1.src.desktop}" alt="image1" loading="lazy" />
        </picture>
        <picture>
            <source media="(max-width: 480px)" srcset="${pdict.image2.src.mobile}" />
            <source media="(max-width: 768px)" srcset="${pdict.image2.src.tablet}" />
            <img src="${pdict.image2.src.desktop}" alt="image1" loading="lazy" />
        </picture>
        <picture>
            <source media="(max-width: 480px)" srcset="${pdict.image3.src.mobile}" />
            <source media="(max-width: 768px)" srcset="${pdict.image3.src.tablet}" />
            <img src="${pdict.image3.src.desktop}" alt="image1" loading="lazy" />
        </picture>
    </div>
</div>