    <div class="custom-product-list" id="${model.id}">
        <isif condition="${model.title}">
            <h2 class="custom-product-list-title">${model.title}</h2>
        </isif>

        <isif condition="${model.insufficientNumberOfProducts}">
            <p class="custom-product-list-empty">No products available.</p>
        <iselse>
            <div class="custom-product-list-container">
                <ul class="custom-product-list-grid">
                    <isloop items="${model.products}" var="product">
                        <li class="custom-product-item">
                            <div class="custom-product-image">
                                <img src="${product.image}" alt="${product.title}" loading="lazy" />
                            </div>
                            <div class="custom-product-info">
                                <h3 class="custom-product-title">${product.title}</h3>
                                <p class="custom-product-price">${product.price}</p>
                            </div>
                        </li>
                    </isloop>
                </ul>
            </div>
        </isif>
    </div>
