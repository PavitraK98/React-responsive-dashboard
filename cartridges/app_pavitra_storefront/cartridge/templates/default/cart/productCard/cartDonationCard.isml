<div class="card product-info ${bonusproductlineitem} uuid-${lineItem.UUID}">
    <!--- name and remove buttons --->
    <isinclude template="cart/productCard/cartProductCardHeader" />

    <div class="row ${bonuslineitemrow}">
        <div class="col-lg-4">
            <div class="item-image">
                <img class="product-image" src="${lineItem.images.small[0].url}" alt="${lineItem.images.small[0].alt}"
                    title="${lineItem.images.small[0].title}" />
            </div>
        </div>
        <div class="col-12 d-lg-none">
            <hr class="line-item-divider" />
        </div>
        <div class="col-lg-4">
            <h5>Donation given by :</h5>
            <h5><b> ${lineItem.isDonationProduct.custom.donationFirstNameP}
                ${lineItem.isDonationProduct.custom.donationLastNameP}</b></h5>
        </div>
        <div class="col-lg-4">
            <isinclude template="cart/productCard/cartDonationCardProductPrice" />
        </div>

        <isif condition="${!lineItem.isBonusProductLineItem}">
            <div class="hidden-md-down">
                <isinclude template="components/deleteButton" />
            </div>
        </isif>
    </div>
</div>