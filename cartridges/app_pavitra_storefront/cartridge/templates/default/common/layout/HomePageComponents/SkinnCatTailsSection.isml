<isscript>
    var assets = require('*/cartridge/scripts/assets.js');
    assets.addCss('/css/customLayout.css');
</isscript>

<div class="custom-skinn-cat-tails-container">
    <div class="skinn-women-cat-tail">
        <img src='${URLUtils.staticURL("/images/women-perfume.webp")}' alt="return" width="550" height="380" />
        <h5>
            <isprint value="${'FOR HER'}" encoding="on" />
        </h5>
    </div>
    <div class="skinn-women-cat-tail">
        <img src='${URLUtils.staticURL("/images/men-perfume.webp")}' alt="return" width="550" height="380" />
        <h5>
            <isprint value="${'FOR HIM'}" encoding="on" />
        </h5>
    </div>
</div>