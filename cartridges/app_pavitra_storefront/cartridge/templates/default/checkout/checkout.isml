<isdecorate template="common/layout/checkout">
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        assets.addCss('/css/customTarte.css');
    </isscript>

    <isif condition="${pdict.reportingURLs && pdict.reportingURLs.length}">
        <isinclude template="reporting/reportingUrls" />
    </isif>
    <div class="container" id="customTrateCheckout">
        <pre>${JSON.stringify(pdict.order)}</pre>
        <pre>${JSON.stringify(pdict.customer)}</pre>
        <!-- Step 1: Shipping methods, selected shipping method and its info -->
        <div class="tarte-shipping-methods">
            <div class="card">
                <div class="card-header cardHeader">
                    Delivery Method
                </div>
                <div class="card-body">
                    <isinclude template="checkout/deliveryMethodSection/deliveryMethod" />
                </div>
            </div>
        </div>
        <!-- Step 2: Delivery address section -->
        <div class="tarte-shipping-address">
            <div class="card">
                <div class="card-header cardHeader">
                    Delivery Address
                </div>
                <div class="card-body">
                    <isinclude template="checkout/deliveryAddressSection/deliveryAddress" />
                </div>
            </div>
        </div>
    </div>
</isdecorate>