<li class="nav-item" data-method-id="${paymentOption.ID}">
    <a class="nav-link" id="credit-card-tab" data-toggle="tab" href="#credit-card-content" role="tab"
        aria-controls="credit-card-content" aria-selected="true">
        <img class="credit-card-option" src="${URLUtils.staticURL('/images/credit.png')}" height="32"
            alt="${paymentOption.name}" title="${paymentOption.name}" />
    </a>
</li>