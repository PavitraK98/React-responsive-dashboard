<isloop items="${pdict.order.billing.payment.applicablePaymentMethods}" var="paymentOption">
    <isif condition="${paymentOption.ID === 'CREDIT_CARD'}">
        <div class="tab-pane fade show active" id="credit-card-content" role="tabpanel"
            aria-labelledby="credit-card-tab" data-payment-method="CREDIT_CARD">
            <isinclude template="checkout/billing/paymentOptions/creditCardContent" />
        </div>
    </isif>
    <iscomment> <isif condition="${paymentOption.ID === 'CREDIT_CARD_P_C'}">
        <div class="tab-pane fade" id="credit-card-pc-content" role="tabpanel" aria-labelledby="credit-card-pc-tab"
            data-payment-method="CREDIT_CARD_P_C">
            <isinclude template="checkout/billing/paymentOptions/creditCardContentPC" />
        </div>
    </isif> </iscomment>
</isloop>