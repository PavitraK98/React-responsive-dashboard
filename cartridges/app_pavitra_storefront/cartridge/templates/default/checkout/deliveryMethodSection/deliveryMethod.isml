<p class="delivery-method-warn-text">Heads up, tartelette! Due to high order volume, you may experience a delay in your
    selected shipping time. We apologize for any inconvenience.</p>
<isloop iterator="${pdict.order.shipping}" alias="shippingModel" status="shipmentLoopState">
    <isloop iterator="${shippingModel.applicableShippingMethods}" alias="method" status="methodLoopState">
        <iscomment> ${JSON.stringify(shippingModel.selectedShippingMethod)} </iscomment>
        <div class="border border-dark p-2">
            <div class="form-check">
                <input class="form-check-input mt-3" type="radio" name="${method.displayName}"
                    checked="${method.displayName === shippingModel.selectedShippingMethod.displayName}" />
                <label class="form-check-label pl-2" for="radioDefault1">
                    <h6c>css="lh-sm p-0 m-0"><b>${method.displayName}:
                            ${method.shippingCost}</b></h6>
                    <p class="lh-sm p-0 m-0">Delivery between ${method.estimatedArrivalTime}</p>
                </label>
            </div>
        </div>
    </isloop>
</isloop>