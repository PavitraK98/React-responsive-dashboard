<?xml version="1.0" encoding="UTF-8"?>
<services xmlns="http://www.demandware.com/xml/impex/services/2014-09-26">
    <service-credential service-credential-id="am.auth">
        <url>https://account.demandware.com/dw/oauth2/access_token</url>
        <user-id>CLIENT_ID</user-id>
        <password>CLIENT_SECRET</password>
    </service-credential>

    <service-credential service-credential-id="scapi.thisbox">
        <url>https://$shortCode$.api.commercecloud.salesforce.com/{apiFamily}/v1/organizations/$tenant$/{apiDetails}</url>
        <user-id/>
        <password/>
    </service-credential>

    <service-profile service-profile-id="scapi.prof">
        <timeout-millis>5000</timeout-millis>
        <rate-limit-enabled>false</rate-limit-enabled>
        <rate-limit-calls>0</rate-limit-calls>
        <rate-limit-millis>0</rate-limit-millis>
        <cb-enabled>false</cb-enabled>
        <cb-calls>0</cb-calls>
        <cb-millis>0</cb-millis>
    </service-profile>

    <service service-id="am.auth">
        <service-type>HTTP</service-type>
        <enabled>true</enabled>
        <log-prefix>amauth</log-prefix>
        <comm-log-enabled>false</comm-log-enabled>
        <force-prd-enabled>true</force-prd-enabled>
        <mock-mode-enabled>false</mock-mode-enabled>
        <profile-id>scapi.prof</profile-id>
        <credential-id>am.auth</credential-id>
    </service>

    <service service-id="scapi.internal">
        <service-type>HTTP</service-type>
        <enabled>true</enabled>
        <log-prefix>scapi</log-prefix>
        <comm-log-enabled>false</comm-log-enabled>
        <force-prd-enabled>true</force-prd-enabled>
        <mock-mode-enabled>false</mock-mode-enabled>
        <profile-id>scapi.prof</profile-id>
        <credential-id>scapi.thisbox</credential-id>
    </service>

</services>
